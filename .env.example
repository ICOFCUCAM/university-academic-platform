# The language model. Without it the offline processor stands in, and says so
# on every artefact it produces.
ANTHROPIC_API_KEY=
ACADEMIC_AI_MODEL=claude-opus-5

# Transcription and speech have no default vendor: a university may require the
# audio never to leave its estate. Named here, implemented in src/lib/ai/.
ACADEMIC_TRANSCRIBER=
ACADEMIC_SPEECH=

# Where the standalone store keeps its snapshot. Unset means in memory only.
ACADEMIC_DATA_DIR=

# Mount path when this is served inside another site.
NEXT_PUBLIC_BASE_PATH=
